# web/ — marketing site build-time configuration.
#
# Copy to `web/.env.local` for local work, and set the same variables in the
# deploy environment. Every value here is read at BUILD time by
# `web/lib/siteConfig.ts`; `next build` FAILS if a required one is missing or
# still holds a placeholder, naming the offending field.
#
# Values are intentionally left blank below. Copying this file verbatim and
# building for production fails loudly, which is the point — there is no
# production fallback anywhere in the repository.
#
# The brand name is NOT here. It is the `BRAND` constant in
# `web/lib/siteConfig.ts`, because it is identical in every environment.
# The registered legal entity name is NOT here either: it is unknown, blocked
# on C-1 (docs/os/clocks.md), and tracked as F-F003.

# REQUIRED in production. Canonical origin — scheme included, no trailing
# slash. Feeds metadataBase, both Open Graph image URLs, the canonical link,
# robots.txt's sitemap pointer, and all five sitemap.xml entries. One value,
# every URL the site asserts about itself.
#   Example: https://prantivo.com
# On Vercel this may be left unset: VERCEL_PROJECT_PRODUCTION_URL is used as a
# fallback and prefixed with https://. Setting it explicitly is safer, and is
# required on any other host. Development falls back to http://localhost:3100.
NEXT_PUBLIC_SITE_URL=

# REQUIRED in production. Public support address, published in the
# Organization JSON-LD contactPoint. Must be an address someone actually reads.
#   Example: support@prantivo.com
NEXT_PUBLIC_CONTACT_EMAIL=

# OPTIONAL. X (Twitter) profile URL. Leave unset if no account exists — the
# JSON-LD then claims no such profile. Do NOT invent a plausible handle: a link
# to a 404 is worse than no link, and the build guard rejects the obvious ones.
#   Example: https://x.com/prantivo
NEXT_PUBLIC_X_URL=

# OPTIONAL. LinkedIn company page URL. Same rule as above.
#   Example: https://www.linkedin.com/company/prantivo
NEXT_PUBLIC_LINKEDIN_URL=
